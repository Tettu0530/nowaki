{
  "name": "@nowaki-dev/runtime",
  "version": "0.15.0",
  "description": "Runtime for Nowaki — islands hydration client, SSR sidecar, and Node loader hooks",
  "license": "MIT",
  "author": "Tettu0530",
  "homepage": "https://nowaki.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tettu0530/nowaki.git",
    "directory": "packages/nowaki-runtime"
  },
  "bugs": "https://github.com/Tettu0530/nowaki/issues",
  "keywords": [
    "nowaki",
    "islands",
    "ssr",
    "preact",
    "web-framework"
  ],
  "type": "module",
  "types": "./index.d.ts",
  "files": [
    "client",
    "server",
    "index.js",
    "index.d.ts",
    "navigation.js",
    "navigation.d.ts",
    "content.js",
    "content.d.ts"
  ],
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./navigation": {
      "types": "./navigation.d.ts",
      "default": "./navigation.js"
    },
    "./content": {
      "types": "./content.d.ts",
      "default": "./content.js"
    },
    "./client/*": "./client/*",
    "./server/*": "./server/*"
  },
  "peerDependencies": {
    "preact": "^10.25.0 || ^11.1.0",
    "preact-render-to-string": "^6.8.2"
  },
  "devDependencies": {
    "preact": "^11.1.1",
    "preact-render-to-string": "^6.8.2"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  }
}
